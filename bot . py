actions_keyboard = rubpy.Keypad(
    rows=[
        [rubpy.Button(text="📜 صدور بیانیه", id="btn_statement")],
        [rubpy.Button(text="🚚 ترابری", id="btn_transport")],
        [rubpy.Button(text="💰 فعالیت اقتصادی", id="btn_economy")],
        [rubpy.Button(text="⚙️ تولید روزانه", id="btn_production")],
