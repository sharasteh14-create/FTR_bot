@bot.on_message()
async def handle_messages(client, message):
    text = message.text
    chat_id = message.chat_id

    if text == "/start":
        await client.send_message(
            chat_id=chat_id,
            text="سلام! به ربات مدیریت جنگ FTR خوش آمدید. 🚀",
            chat_keypad=main_keyboard
        )

    elif text == "⚔️ اقدامات فعالیت":
        await client.send_message(
            chat_id=chat_id,
            text="منوی اقدامات:",
            chat_keypad=actions_keyboard
        )

    elif text == "📜 صدور بیانیه":
        await client.send_message(chat_id=chat_id, text="متن بیانیه را با /بیانیه ارسال کنید.")

    elif text.startswith("/بیانیه "):
        statement_text = text.replace("/بیانیه ", "")
        await client.send_message(
            chat_id=CHANNEL_ID,
            text=statement_text
        )
        await client.send_message(chat_id=chat_id, text="ارسال شد.")

async def main():
    await bot.run()

if __name__ == "__main__":
    asyncio.run(main())
